name: Auto Build VPN APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Download source
        uses: actions/checkout@v4

      - name: Install Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Find Gradle project
        shell: bash
        run: |
          set -e

          if [ -f gradlew ]; then
            chmod +x gradlew
            echo "GRADLE_CMD=./gradlew" >> "$GITHUB_ENV"
          elif [ -f app/build.gradle ] || [ -f app/build.gradle.kts ]; then
            echo "No Gradle wrapper found."
            exit 1
          else
            echo "Gradle project not found."
            exit 1
          fi

      - name: Build APK
        run: ${{ env.GRADLE_CMD }} assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: MyTunnelApp-debug
          path: '**/build/outputs/apk/debug/*.apk'
          if-no-files-found: error
          retention-days: 7